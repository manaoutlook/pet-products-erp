# Database Configuration
# Copy this file to .env and update with your database credentials
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Example configurations for different environments:
# Local development
# DATABASE_URL=postgresql://postgres:admin123@localhost:5432/smart_erp

# Production (use environment-specific values)
# DATABASE_URL=postgresql://user:password@host:port/database

# Application Configuration
NODE_ENV=development
PORT=5000

# Which deployment this is: production | staging | development.
# Shown in the top-right badge of every screen, on the login screen, and as a
# prefix on the browser tab. Leave it unset and the app shows a red "ENV?"
# badge instead of assuming you are on production.
APP_ENV=development

# Session Configuration
SESSION_SECRET=your-secret-key-here

# Website stock sync (WooCommerce) - encrypts each shop's API key at rest.
# Any 16+ character passphrase; rotating it makes stored keys unreadable until they are re-entered.
INTEGRATION_SECRET_KEY=change-me-to-a-long-random-string

# Nightly backups (deploy/backup.sh, see docs/PRODUCTION_SERVER.md Step 10).
# BACKUP_RCLONE_REMOTE is an rclone remote + folder, e.g. onedrive:SmartERP-backups.
# Leave it empty to keep backups on the server only.
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=30

# Other environment variables can be added here as needed
