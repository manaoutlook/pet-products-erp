{
  "include": ["client/src/**/*", "db/**/*", "server/**/*", "shared/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    // AI Agent Note: `baseUrl` is deliberately omitted. TypeScript 6.0 deprecates it and 7.0
    // removes it; since TS 4.1 `paths` resolve relative to this tsconfig file, so the aliases
    // below keep working without it.
    "paths": {
      "@db": ["./db/index.ts"],
      "@db/*": ["./db/*"],
      "@shared/*": ["./shared/*"],
      "@/*": ["./client/src/*"]
    }
  }
}
